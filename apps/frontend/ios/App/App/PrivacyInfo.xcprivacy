<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's privacy manifest. Apple matches the required reason APIs
	     referenced by the app binary against the manifests in the bundle
	     (ITMS-91053 when one is missing). @capgo/capacitor-social-login is
	     compiled into this binary from source and ships no manifest of its
	     own, and its providers read and write UserDefaults, so the reason is
	     declared here. Capacitor, GoogleSignIn, Alamofire, AppAuth, GTMAppAuth
	     and GTMSessionFetcher carry their own manifests. The Facebook SDK is
	     not linked (capacitor.config.ts turns the provider off; the CI audit
	     reads the binary), so no tracking framework is in the bundle and
	     NSPrivacyTracking is false with nothing to list under it.
	     CA92.1: user defaults accessed only by this app, for this app. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
