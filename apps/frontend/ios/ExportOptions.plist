<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Read by `xcodebuild -exportArchive` in .github/workflows/ios-testflight.yml.
	     method app-store-connect + destination upload: Xcode 15+ signs the
	     archive with the cloud-managed distribution certificate and uploads it
	     to App Store Connect itself, authenticated by the same API key as the
	     archive step. No altool, no Transporter, no certificate in secrets.
	     No testFlightInternalTestingOnly since 2026-10-17 (the submission build).
	     With that key every upload "cannot be distributed via external
	     TestFlight or the App Store" and read buildAudienceType INTERNAL_ONLY
	     (builds 5 to 34). Without it, Xcode's default, the upload is the same
	     and the build is also eligible for App Review. Nothing is submitted by
	     this file: that takes Add for Review in App Store Connect.
	     manageAppVersionAndBuildNumber: Xcode bumps a stale CFBundleVersion in
	     the staged copy at upload, the safety net behind the run number. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>NQ23SMHXJV</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
</dict>
</plist>
