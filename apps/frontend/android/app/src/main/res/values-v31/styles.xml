<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12 and later only (API 31+). From API 31 the system draws the
         launch screen itself, from windowSplashScreenBackground and
         windowSplashScreenAnimatedIcon, and ignores android:background. With
         only android:background set (values/styles.xml), API 31+ showed the
         system default background and the launcher icon instead of the app's
         dark splash. API 30 and below never read this file: they keep
         values/styles.xml and drawable*/splash.png exactly as before.
         The background is #0F1014, the colour capacitor.config.ts, the iOS
         LaunchScreen.storyboard and the splash PNGs share (iosPlatform.test.ts).
         The icon is the flat mark, generated by assets/generate-android-icons.py. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#0F1014</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
